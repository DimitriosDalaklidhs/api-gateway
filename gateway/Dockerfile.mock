FROM python:3.12.14-slim

WORKDIR /app

# curl is for the healthcheck and for switching failure mode with `kubectl exec`.
# Not pinned, for the reason given in Dockerfile.
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY mock_service.py .

# The same unprivileged user as the gateway image. This one writes nothing.
RUN groupadd --gid 10001 gateway && \
    useradd --uid 10001 --gid 10001 --home-dir /app --no-create-home --shell /usr/sbin/nologin gateway
USER 10001:10001

EXPOSE 8010

CMD ["uvicorn", "mock_service:app", "--host", "0.0.0.0", "--port", "8010"]
